{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!test/integration/regtest/.cache",
      "!test/e2e/devnet/.runtime",
      "!test/e2e/devnet/artifacts",
      "!test/e2e/devnet/deployments",
      "!test/e2e/devnet/playwright-report",
      "!test/e2e/devnet/test-results",
      "!contracts/**/*.clar",
      "!design",
      "!design/fonts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
