# Dedicated PoX-5 Testnet values below are ready to use unless marked REPLACE.
# The built-in profile supplies network ID 0x80000005 and the contract metadata.
# Used only with compose.release.yaml. Keep this pinned to a GitHub release tag.
SIDEKICK_IMAGE_TAG=v1.0.0
SIDEKICK_NETWORK=pox5-testnet
STACKS_API_URL=https://api.testnet-pox5.hiro.so
STACKS_API_KEY_HEADER=x-api-key
SIDEKICK_FORECAST_HORIZON_CYCLES=6
# Optional: defaults to observe. Keep this value unless Assist rollout gates are complete.
# SIDEKICK_ENGINE_MODE=observe

# Required: use a PoX-5 Testnet node RPC endpoint reachable from the Sidekick container.
# The node must also have [node] txindex = true; connection check verifies it.
STACKS_NODE_RPC_URL=http://REPLACE_WITH_NODE_RPC:20443
# Required: an already-deployed PoX-5 signer-manager contract principal.
SIDEKICK_MANAGER_PRINCIPAL=ST_REPLACE_WITH_ADMIN.signer-manager
# Required: generate a unique value as described in docs/operator/deployment.md.
SIDEKICK_AUTH_TOKEN=REPLACE_ME
# Optional reverse-proxy login. See docs/operator/deployment.md before enabling either setting.
# SIDEKICK_AUTH_TRUSTED_HEADER=X-Sidekick-Operator
# SIDEKICK_AUTH_BASIC_USERNAME=operator

# Optional: set for a keyed or self-hosted Stacks API.
# STACKS_API_KEY=
# Recommended: enable the Signer Health page's direct process telemetry.
# STACKS_NODE_METRICS_URL=http://REPLACE_WITH_NODE_METRICS:9153/metrics
# STACKS_SIGNER_MONITORING_URL=http://REPLACE_WITH_SIGNER_MONITORING:30001
# Optional: overrides the built-in public Hiro PoX-5 Testnet comparison endpoint.
# HIRO_REFERENCE_API_URL=https://api.testnet-pox5.hiro.so
# Optional: use a separate key when the comparison API is on a different account or origin.
# The indexed API key is reused automatically when both APIs have the same origin.
# HIRO_REFERENCE_API_KEY=
# HIRO_REFERENCE_API_KEY_HEADER=x-api-key
# Optional: set only to bind Sidekick to an intentional private-network address.
# SIDEKICK_PUBLISH_ADDRESS=
# Private Stacks Core event listener. The default publishes it only on host loopback.
# SIDEKICK_EVENT_PUBLISH_ADDRESS=127.0.0.1
# SIDEKICK_EVENT_HTTP_ENABLED=true
# SIDEKICK_EVENT_HTTP_PORT=3700
# SIDEKICK_EVENT_MAX_BODY_BYTES=4194304
