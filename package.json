{
  "name": "signer-sidekick",
  "version": "0.0.0",
  "private": true,
  "description": "PoX-5 operations tooling for Stacks signer and pool operators",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.18.0",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "biome check . && pnpm typecheck",
    "check:fix": "biome check --write .",
    "typecheck": "pnpm --filter @stx-labs/signer-sidekick-protocol build && pnpm --filter @stx-labs/signer-sidekick-core build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:regtest": "vitest run test/integration/regtest",
    "protocol:vendor": "node scripts/vendor-upstream.mjs",
    "protocol:verify": "node scripts/verify-upstream.mjs",
    "protocol:generate:mainnet": "pnpm --filter @stx-labs/signer-sidekick-protocol generate:mainnet"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "26.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
