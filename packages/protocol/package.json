{
  "name": "@stx-labs/signer-sidekick-protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./clarity-codecs": {
      "types": "./dist/clarity-codecs.d.ts",
      "default": "./dist/clarity-codecs.js"
    },
    "./manager-adapter": {
      "types": "./dist/manager-adapter.d.ts",
      "default": "./dist/manager-adapter.js"
    },
    "./pox5-bonds": {
      "types": "./dist/pox5-bonds.d.ts",
      "default": "./dist/pox5-bonds.js"
    },
    "./pox5-calculate-rewards": {
      "types": "./dist/pox5-calculate-rewards.d.ts",
      "default": "./dist/pox5-calculate-rewards.js"
    },
    "./pox5-events": {
      "types": "./dist/pox5-events.d.ts",
      "default": "./dist/pox5-events.js"
    },
    "./manager-claim-rewards": {
      "types": "./dist/manager-claim-rewards.d.ts",
      "default": "./dist/manager-claim-rewards.js"
    },
    "./manager-claim-staker-rewards": {
      "types": "./dist/manager-claim-staker-rewards.d.ts",
      "default": "./dist/manager-claim-staker-rewards.js"
    },
    "./manager-interface-fingerprint": {
      "types": "./dist/manager-interface-fingerprint.d.ts",
      "default": "./dist/manager-interface-fingerprint.js"
    },
    "./manager-artifact": {
      "types": "./dist/manager-artifact.d.ts",
      "default": "./dist/manager-artifact.js"
    },
    "./manager-events": {
      "types": "./dist/manager-events.d.ts",
      "default": "./dist/manager-events.js"
    },
    "./known-managers": {
      "types": "./dist/known-managers.d.ts",
      "default": "./dist/known-managers.js"
    },
    "./installed-manager-profile": {
      "types": "./dist/installed-manager-profile.d.ts",
      "default": "./dist/installed-manager-profile.js"
    },
    "./network-compatibility": {
      "types": "./dist/network-compatibility.d.ts",
      "default": "./dist/network-compatibility.js"
    },
    "./compatibility-attestation": {
      "types": "./dist/compatibility-attestation.d.ts",
      "default": "./dist/compatibility-attestation.js"
    },
    "./network-manager-artifact": {
      "types": "./dist/network-manager-artifact.d.ts",
      "default": "./dist/network-manager-artifact.js"
    },
    "./known-network-compatibility": {
      "types": "./dist/known-network-compatibility.d.ts",
      "default": "./dist/known-network-compatibility.js"
    },
    "./principals": {
      "types": "./dist/principals.d.ts",
      "default": "./dist/principals.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:manager": "tsx src/generate-manager.ts",
    "generate:mainnet": "tsx src/generate-manager.ts --profile ../../contracts/reference-manager/profiles/mainnet.json --source ../../contracts/reference-manager/upstream/signer-manager.clar --output ../../contracts/reference-manager/generated/mainnet/signer-manager.clar",
    "generate:devnet": "tsx src/generate-manager.ts --profile ../../contracts/reference-manager/profiles/devnet.json --source ../../contracts/reference-manager/upstream/signer-manager.clar --output ../../contracts/reference-manager/generated/devnet/signer-manager.clar",
    "generate:regtest": "tsx src/generate-manager.ts --profile ../../contracts/reference-manager/profiles/regtest.json --source ../../contracts/reference-manager/upstream/signer-manager.clar --output ../../contracts/reference-manager/generated/regtest/signer-manager.clar"
  },
  "dependencies": {
    "@stacks/transactions": "7.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
