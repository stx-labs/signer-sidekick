{
  "name": "@stx-labs/signer-sidekick",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "attach": "node dist/main.js attach",
    "cli": "node dist/main.js",
    "dev": "tsx watch src/main.ts serve",
    "preflight": "node dist/main.js preflight",
    "start": "node dist/main.js serve",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "10.1.2",
    "@stacks/transactions": "7.5.0",
    "@stx-labs/signer-sidekick-api-contracts": "workspace:*",
    "@stx-labs/signer-sidekick-protocol": "workspace:*",
    "fastify": "5.11.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
