# Copy to .env and replace every placeholder before running Docker Compose.
SIDEKICK_NETWORK=mainnet
STACKS_NODE_RPC_URL=http://host.docker.internal:20443
# Leave unset for the network-appropriate Hiro default, or set a self-hosted API URL.
# STACKS_API_URL=https://api.mainnet.hiro.so
# STACKS_API_KEY=
# STACKS_API_KEY_HEADER=x-api-key
SIDEKICK_MANAGER_PRINCIPAL=SP000000000000000000002Q6VF78.replace-with-manager
# Generate with: openssl rand -base64 32
SIDEKICK_AUTH_TOKEN=replace-with-at-least-24-random-characters
SIDEKICK_FORECAST_HORIZON_CYCLES=6
