# Copy to .env and replace every placeholder before running Docker Compose.
# For a public testnet trial, set SIDEKICK_NETWORK=testnet and use ST principals.
SIDEKICK_NETWORK=mainnet
STACKS_NODE_RPC_URL=http://host.docker.internal:20443
# Leave unset for the network-appropriate Hiro default, or set a self-hosted API URL.
# STACKS_API_URL=https://api.mainnet.hiro.so
# STACKS_API_KEY=
# STACKS_API_KEY_HEADER=x-api-key
# Override the expected chain/network ID for a private or custom network whose
# node reports a nonstandard network_id (defaults: mainnet=1, others=0x80000000).
# SIDEKICK_NETWORK_ID=256
SIDEKICK_MANAGER_PRINCIPAL=SP000000000000000000002Q6VF78.replace-with-manager
# Compose mounts ./trusted-managers read-only for optional operator-installed profiles.
# Operator-provided network compatibility data in ./network-compatibility is mounted separately.
# These files can guide read-only/setup behavior but cannot enable transaction automation.
# Generate with: openssl rand -base64 32
SIDEKICK_AUTH_TOKEN=replace-with-at-least-24-random-characters
SIDEKICK_FORECAST_HORIZON_CYCLES=6
